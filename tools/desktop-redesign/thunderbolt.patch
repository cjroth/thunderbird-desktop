+
+/** Seal to a replica verified against the pinned model repository. The gateway only relays sealed bodies. */
+const createPinnedGateway = async (pin: ModelPin, settings: RouterOptions): Promise<HttpClient> => {
+  const gateway = await GatewayHTTPClient.create({
+    modelPins: new Map([[pin.model, { repo: pin.repo }]]),
+    pinnedModelsOnly: true,
+    signal: settings.signal,
+    userCacheSecret: settings.userCacheSecret,
+    verificationCheck: settings.verificationCheck,
+  })
+  let verifiedHost = ''
+  return {
+    baseURL: gateway.baseURL,
+    fetch: gateway.fetch,
+    close: () => gateway.close(),
+    get enclave() {
+      return verifiedHost
+    },
+    ensureVerified: async (options) => {
+      const proof = await gateway.ensureVerified(pin.model, options)
+      const replica = gateway.current.find((entry) => entry.verification === proof && entry.pinnedModel === pin.model)
+      if (!replica) {
+        throw new Error('Tinfoil could not identify the verified model replica.')
+      }
+      verifiedHost = replica.host
+      return proof
+    },
+  }
